{
  "name": "tracto-trak-backend",
  "version": "1.0.0",
  "description": "API REST del Sistema de Gestión para el Autotransporte de Carga (SPF) — Tracto Trak",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --detectOpenHandles --verbose",
    "test:watch": "jest --watch --forceExit --detectOpenHandles"
  },
  "keywords": ["autotransporte", "fletes", "gastos", "liquidaciones", "spf"],
  "author": "Equipo Tracto Trak",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.1",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/test/**/*.test.js"],
    "testTimeout": 30000
  }
}
